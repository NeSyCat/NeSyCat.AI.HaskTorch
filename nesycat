#!/usr/bin/env bash
# Run a NeSyCat example by its exact folder name:   ./nesycat <ExampleName> [n]
#   e.g.  ./nesycat MnistAddition 1     ./nesycat Binary 10
#
# Examples are auto-discovered: every Examples/<Name>/ folder (except _template)
# is registered automatically by regenerating the dispatcher Library/Run.hs from
# the folder list. Add a folder and it just works — no manual registration.
set -euo pipefail

# libtorch/OpenMP spins up a thread pool for every tensor op. These are small-tensor
# workloads (batch 64, tiny finite supports, a small CNN), so the per-op thread-launch
# overhead dominates the actual compute -- a single thread is ~2x faster end-to-end here
# (the kernel/sys time collapses from ~25s to ~0.1s). HaskTorch exposes no in-program
# at::set_num_threads, so it is set here, at process launch. Override to benchmark, e.g.
#   OMP_NUM_THREADS=4 ./nesycat MnistAddition 1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

# Resolve symlinks so this works when invoked via a PATH symlink (e.g. ~/.local/bin/nesycat).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ $src != /* ]] && src="$dir/$src"
done
ROOT="$(cd -P "$(dirname "$src")" && pwd)"
cd "$ROOT"

# example folder names (skip the _template stamp and dotfiles)
names=$(for d in Examples/*/; do b=$(basename "$d"); [[ "$b" == _* ]] || echo "$b"; done | sort)

gen() {
  cat <<'HS_HEAD'
{-# LANGUAGE TypeApplications #-}

-- | GENERATED by ./nesycat -- do not edit by hand. Dispatches an example by its
--   exact Examples/<Name>/ folder name; adding a folder is picked up
--   automatically on the next ./nesycat run (no manual registration).
module Run (runNeSyCat) where

import Example (runExample)
import System.Exit (die)
HS_HEAD
  for n in $names; do echo "import $n.Definition ($n)"; done
  cat <<'HS_MID'

runNeSyCat :: [String] -> IO ()
runNeSyCat (name : rest) = case lookup name registry of
  Just run -> run (parseN rest)
  Nothing -> die ("unknown example: " ++ name ++ "  (available: " ++ unwords (map fst registry) ++ ")")
  where
    parseN (x : _) = read x
    parseN [] = 1
runNeSyCat [] = die "usage: nesycat <ExampleName> [n]   (e.g. nesycat MnistAddition 1)"

registry :: [(String, Int -> IO ())]
registry =
HS_MID
  local sep='['
  for n in $names; do echo "  $sep (\"$n\", runExample @$n \"$n\")"; sep=','; done
  echo '  ]'
}

# Regenerate Library/Run.hs only when the example set changed; re-glob with hpack
# so any newly-added modules are in the build.
tmp="$(mktemp)"; gen >"$tmp"
if ! cmp -s "$tmp" Library/Run.hs 2>/dev/null; then
  mv "$tmp" Library/Run.hs
  ~/.cabal/bin/hpack --force >/dev/null 2>&1 || hpack --force >/dev/null 2>&1 || true
else
  rm -f "$tmp"
fi

exec cabal run -v0 nesycat -- "$@"
