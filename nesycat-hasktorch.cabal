cabal-version: 2.4
name: nesycat-hasktorch
version: 0.1.0.0
synopsis: NeSyCat Framework with HaskTorch
description: Typed tensor category for the NeSyCat neurosymbolic framework
license: MIT
author: User
maintainer: user@example.com

library
  exposed-modules:
    -- Alpha: Categorical
    A_Categorical.CategoricalSignature,
    A_Categorical.CategoricalInterpretation,
    A_Categorical.Category.Categories.Data,
    A_Categorical.Category.Categories.Tens,
    A_Categorical.Category.Monads.Dist,
    A_Categorical.Category.Monads.Giry,
    A_Categorical.Category.Monads.DistExpect,
    A_Categorical.Category.Monads.GiryExpect,
    -- Beta: Logical
    B_Logical.LogicalSignature,
    B_Logical.LogicalQuantSignature,
    B_Logical.Interpretations.Boolean,
    B_Logical.Interpretations.Tensor,
    -- Gamma: Domain
    C_Domain.Examples.Binary.Signature,
    C_Domain.Examples.Binary.Interpretation,
    C_Domain.Models.MLP,
    C_Domain.Models.MnistCNN,
    C_Domain.Examples.MnistAddition.Signature,
    C_Domain.Examples.MnistAddition.Interpretation,
    -- Delta: Grammatical
    D_Grammatical.Examples.Binary.Formulas,
    D_Grammatical.Examples.Binary.IntpTens,
    D_Grammatical.Examples.Binary.IntpData,
    D_Grammatical.Examples.MnistAddition.Formulas,
    D_Grammatical.Examples.MnistAddition.IntpData,
    D_Grammatical.Examples.MnistAddition.IntpTens,
    -- Epsilon: Inferential
    E_Inferential.Train,
    E_Inferential.InferenceSignature,
    E_Inferential.InferenceInterpretation,
    E_Inferential.Library.Softplus,
    E_Inferential.Library.OneMinus,
    E_Inferential.Library.NegLog,
    E_Inferential.Library.CrossEntropy,
    E_Inferential.Library.Convex,
    E_Inferential.Examples.Binary.Train,
    E_Inferential.Examples.MnistAddition.Train,
    -- Zeta: Statistical
    F_Statistical.BenchmarkSignature,
    F_Statistical.BenchmarkInterpretation,
    F_Statistical.Report,
    F_Statistical.Library.Threshold,
    F_Statistical.Library.FractionTrue,
    F_Statistical.Library.HarmonicMean,
    F_Statistical.Library.MeanWhere,
    -- Examples: generic runner + per-example registrations
    Example,
    Examples.Binary,
    Examples.MnistAddition
  hs-source-dirs: .
  build-depends:
    base >=4.16,
    bytestring,
    containers,
    directory,
    mtl,
    numeric-tools,
    hasktorch,
    statistics,
    time
  default-language: Haskell2010

executable nesycat
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options: -rtsopts
  build-depends:
    base,
    nesycat-hasktorch,
    hasktorch
  default-language: Haskell2010

